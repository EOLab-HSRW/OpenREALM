@PACKAGE_INIT@

set(_OPENREALM_AVAILABLE_COMPONENTS @AVAILABLE_COMPONENTS@)

foreach(_comp IN LISTS @PROJECT_NAME@_FIND_COMPONENTS)
    list(FIND _OPENREALM_AVAILABLE_COMPONENTS "${_comp}" _idx)
  if(_idx EQUAL -1)
      set(@PROJECT_NAME@_${_comp}_FOUND FALSE)
      if(@PROJECT_NAME@_FIND_REQUIRED_${_comp})
          message(FATAL_ERROR "@PROJECT_NAME@: requested component '${_comp}' is not available in this installation.")
    endif()
  else()
    set(@PROJECT_NAME@_${_comp}_FOUND TRUE)
  endif()
endforeach()

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

check_required_components(@PROJECT_NAME@)
